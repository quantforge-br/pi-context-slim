{
  "name": "pi-context-budget-optimizer",
  "version": "0.1.0",
  "description": "Compact redundant Pi tool prompt metadata without changing tool behavior",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/quantforge-br/pi-context-budget-optimizer.git"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "pi-extension",
    "prompt",
    "context"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "package.json"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "scripts": {
    "check": "node --check src/index.ts",
    "pack": "npm pack --dry-run"
  }
}
